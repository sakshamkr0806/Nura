# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nura"

# JWT Secrets - Use strong random 256-bit keys (e.g. generated via `openssl rand -base64 32`)
# WARNING: Do not commit actual secrets to version control!
AT_SECRET="change-this-to-a-very-strong-unique-access-token-secret-key"
RT_SECRET="change-this-to-a-very-strong-unique-refresh-token-secret-key"

# Google Gemini API key for health profile & insights generator
GEMINI_API_KEY="your-gemini-api-key"

# CORS configuration
FRONTEND_URL="http://localhost:5173"

# Application Port
PORT=3000

# Resend Email Configuration
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
