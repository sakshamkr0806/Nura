// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshToken String?

  phoneNumber        String?  @unique
  dateOfBirth        DateTime?
  emailNotifications Boolean  @default(true)

  onboardingCompleted Boolean  @default(false)
  currentStreak       Int      @default(0)
  longestStreak       Int      @default(0)

  cycles        Cycle[]
  dailyLogs     DailyLog[]
  alerts        Alert[]
  lifestyle     UserLifestyle?
  healthHistory UserHealthHistory?
  goals         UserGoals?
  symptoms      UserSymptoms?
  healthProfile HealthProfile?

  @@map("users")
}

model Cycle {
  id        String    @id @default(uuid())
  startDate DateTime
  endDate   DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cycles")
}

model DailyLog {
  id           String   @id @default(uuid())
  date         DateTime
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  symptoms     String[]
  moods        String[]
  sleepHours   Float?
  waterIntake  Int?     // in ml
  notes        String?

  energyLevel     Int?
  stressLevel     Int?
  exerciseMinutes Int?
  nutritionNotes  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
  @@map("daily_logs")
}

model Alert {
  id        String     @id @default(uuid())
  title     String
  message   String
  level     AlertLevel
  isRead    Boolean    @default(false)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("alerts")
}

enum AlertLevel {
  INFO
  ATTENTION
  MEDICAL_SUGGESTION
}

model Article {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String
  excerpt   String
  category  String
  tags      String[]
  imageUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("articles")
}

enum Role {
  USER
  ADMIN
}

model UserLifestyle {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sleepHours    Float
  waterIntake   Int
  activityLevel String
  stressLevel   String
  screenTime    Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("user_lifestyles")
}

model UserHealthHistory {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hasPcos              Boolean
  hasThyroid           Boolean
  hasHormonalImbalance Boolean
  medications          String[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("user_health_histories")
}

model UserGoals {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals     String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_goals")
}

model UserSymptoms {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symptoms     String[]
  painSeverity String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user_symptoms")
}

model HealthProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wellnessScore    Int
  cycleHealthScore Int
  sleepScore       Int
  stressScore      Int
  stressIndicator  String
  sleepAnalysis    String
  stressAnalysis   String
  cycleInsights    String
  hydrationRecs    String[]
  nutritionRecs    String[]
  actionPlan       String[]
  dailyRecs        String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("health_profiles")
}
