generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  password            String
  fullName            String
  role                Role               @default(USER)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  refreshToken        String?
  phoneNumber         String?            @unique
  dateOfBirth         DateTime?
  emailNotifications  Boolean            @default(true)
  currentStreak       Int                @default(0)
  longestStreak       Int                @default(0)
  onboardingCompleted Boolean            @default(false)
  alerts              Alert[]
  cycles              Cycle[]
  dailyLogs           DailyLog[]
  healthProfile       HealthProfile?
  goals               UserGoals?
  healthHistory       UserHealthHistory?
  lifestyle           UserLifestyle?
  symptoms            UserSymptoms?

  @@map("users")
}

model Cycle {
  id        String    @id @default(uuid())
  startDate DateTime
  endDate   DateTime?
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cycles")
}

model DailyLog {
  id              String   @id @default(uuid())
  date            DateTime
  userId          String
  symptoms        String[]
  moods           String[]
  sleepHours      Float?
  waterIntake     Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  energyLevel     Int?
  exerciseMinutes Int?
  nutritionNotes  String?
  stressLevel     Int?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_logs")
}

model Alert {
  id        String     @id @default(uuid())
  title     String
  message   String
  level     AlertLevel
  isRead    Boolean    @default(false)
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

model Article {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String
  excerpt   String
  category  String
  tags      String[]
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("articles")
}

model UserLifestyle {
  id            String   @id @default(uuid())
  userId        String   @unique
  sleepHours    Float
  waterIntake   Int
  activityLevel String
  stressLevel   String
  screenTime    Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_lifestyles")
}

model UserHealthHistory {
  id                   String   @id @default(uuid())
  userId               String   @unique
  hasPcos              Boolean
  hasThyroid           Boolean
  hasHormonalImbalance Boolean
  medications          String[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_health_histories")
}

model UserGoals {
  id        String   @id @default(uuid())
  userId    String   @unique
  goals     String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_goals")
}

model UserSymptoms {
  id           String   @id @default(uuid())
  userId       String   @unique
  symptoms     String[]
  painSeverity String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_symptoms")
}

model HealthProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  wellnessScore    Int
  cycleHealthScore Int
  sleepScore       Int
  stressScore      Int
  stressIndicator  String
  sleepAnalysis    String
  stressAnalysis   String
  cycleInsights    String
  hydrationRecs    String[]
  nutritionRecs    String[]
  actionPlan       String[]
  dailyRecs        String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("health_profiles")
}

enum AlertLevel {
  INFO
  ATTENTION
  MEDICAL_SUGGESTION
}

enum Role {
  USER
  ADMIN
}
